# Server settings for docker compose.
# Copy this file to ".env" (next to docker-compose.yml) and adjust the values,
# docker compose reads it automatically. Remove a line to use its default value.

# Host folder where calendars are stored (one JSON file per calendar),
# relative to docker-compose.yml. Must be writable by uid 1000.
CALENDARS_PATH=./calendars

# Set to 1 if the app runs behind ONE reverse proxy (nginx, traefik, caddy...)
# so that rate limiting sees the real client IPs.
# Leave empty if clients reach the app directly, otherwise they could spoof their IP.
TRUST_PROXY=

# Storage quotas: creating new calendars is refused once reached
MAX_CALENDARS=10000
MAX_STORAGE_MB=200

# Calendars not modified for this number of days are deleted (0 to disable)
PURGE_AFTER_DAYS=365

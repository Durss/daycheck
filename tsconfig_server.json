{
	"compilerOptions": {
		"target": "ES2022",
		"module": "nodenext",
		"strict": true,
		"noImplicitAny": false,
		"noImplicitThis": false,
		"strictNullChecks": false,
		"sourceMap": false,
		"rootDir": "./src_server",
		"outDir": "./server",
		"skipLibCheck": true,
		"types": [
			"node"
		],
		"lib": [
			"ES2022"
		]
	},
	"include": [
		"src_server/**/*.ts"
	]
}

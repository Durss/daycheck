{
  "name": "daycheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others \"npm run front/serve\" \"npm run server/watch\"",
    "build": "npm run front/build && npm run server/build",
    "front/serve": "vue-cli-service serve",
    "front/build": "vue-cli-service build",
    "server/watch": "tsc -w -p ./tsconfig_server.json",
    "server/build": "tsc -p ./tsconfig_server.json"
  },
  "dependencies": {
    "body-parser": "^1.19.0",
    "connect-history-api-fallback": "^2.0.0",
    "express": "^4.17.3",
    "express-serve-static-core": "^0.1.1",
    "http": "0.0.0",
    "vue": "^2.6.12",
    "vue-class-component": "^7.2.6",
    "vue-property-decorator": "^9.1.2",
    "vue-router": "^3.4.9",
    "vuex": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.11",
    "@types/qrcode": "^1.3.5",
    "@vue/cli-plugin-router": "^5.0.8",
    "@vue/cli-plugin-typescript": "^5.0.8",
    "@vue/cli-plugin-vuex": "^5.0.8",
    "@vue/cli-service": "^5.0.8",
    "concurrently": "^5.3.0",
    "gsap": "^3.6.0",
    "less": "^4.1.0",
    "less-loader": "^7.2.1",
    "lz-string": "^1.4.4",
    "qrcode": "^1.4.4",
    "ssri": "^8.0.1",
    "typescript": "~4.1.3",
    "vue-template-compiler": "^2.6.12"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "postcss": "^8.5.15",
    "webpack-dev-server": "^5.2.5"
  }
}

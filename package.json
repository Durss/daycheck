{
  "name": "daycheck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run server/build && concurrently --kill-others --names front,tsc,api \"npm run front/serve\" \"npm run server/watch\" \"npm run server/serve\"",
    "build": "npm run front/build && npm run server/build",
    "front/serve": "vite",
    "front/build": "vue-tsc --noEmit && vite build",
    "server/watch": "tsc -w --preserveWatchOutput -p ./tsconfig_server.json",
    "server/serve": "node --watch server/bootstrap.js",
    "server/build": "tsc -p ./tsconfig_server.json"
  },
  "dependencies": {
    "connect-history-api-fallback": "^2.0.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "gsap": "^3.15.0",
    "less": "^4.9.1",
    "lz-string": "^1.5.0",
    "pinia": "^4.1.0",
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-tsc": "^3.3.13"
  }
}
